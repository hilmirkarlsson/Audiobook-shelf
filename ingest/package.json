    "ingest-aax": "node src/ingest-aax.js",
    "ingest-plain": "node src/ingest-plain.js"
  },
  "dependencies": {
    "googleapis": "^144.0.0",
    "open": "^10.1.0",
    "uuid": "^9.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
